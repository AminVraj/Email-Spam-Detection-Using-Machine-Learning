{
  "manifest_version": 3,
  "name": "Email Sentinel AI",
  "version": "1.0.0",
  "description": "Analyze your Gmail with machine learning",
  "permissions": [
    "identity",
    "tabs"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://localhost:5173/*"
  ],
  "oauth2": {
    "client_id": "1044023892905-910jptpfgub2ag6am67ocpgukhcnrgd1.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html"
  }
}
